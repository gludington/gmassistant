name = "gmassisstant-api"
main = "src/index.ts"
compatibility_date = "2024-09-23"

[build]
# Ensure backend dist is up-to-date before bundling
command = "pnpm --filter @gmassisstant/backend build"
watch_dir = ["../backend/src"]

[[d1_databases]]
binding = "DB"
database_name = "${CF_D1_DATABASE_NAME}"
database_id = "${CF_D1_DATABASE_ID}"

[[r2_buckets]]
binding = "UPLOADS"
bucket_name = "${CF_R2_BUCKET_NAME}"
